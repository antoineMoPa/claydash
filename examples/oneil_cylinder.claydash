                ],
                "efflorescence": 0.16
              }
            },
            "wgsl": "var s=base;\nvar p=point*1.15+vec3<f32>(3.2,1.8,2.4);\np+=vec3<f32>(sin(point.y*0.48),sin(point.z*0.41),sin(point.x*0.53))*0.42;\nvar total=0.0;\nvar weight=0.0;\nvar amplitude=0.5;\nfor(var octave=0;octave<5;octave=octave+1){\n  let c=floor(p);\n  let f=fract(p);\n  let t=f*f*(3.0-2.0*f);\n  let k=vec3<f32>(127.1,311.7,74.7);\n  let n000=fract(sin(dot(c+vec3<f32>(0.0,0.0,0.0),k))*43758.5453);\n  let n100=fract(sin(dot(c+vec3<f32>(1.0,0.0,0.0),k))*43758.5453);\n  let n010=fract(sin(dot(c+vec3<f32>(0.0,1.0,0.0),k))*43758.5453);\n  let n110=fract(sin(dot(c+vec3<f32>(1.0,1.0,0.0),k))*43758.5453);\n  let n001=fract(sin(dot(c+vec3<f32>(0.0,0.0,1.0),k))*43758.5453);\n  let n101=fract(sin(dot(c+vec3<f32>(1.0,0.0,1.0),k))*43758.5453);\n  let n011=fract(sin(dot(c+vec3<f32>(0.0,1.0,1.0),k))*43758.5453);\n  let n111=fract(sin(dot(c+vec3<f32>(1.0,1.0,1.0),k))*43758.5453);\n  let low=mix(mix(n000,n100,t.x),mix(n010,n110,t.x),t.y);\n  let high=mix(mix(n001,n101,t.x),mix(n011,n111,t.x),t.y);\n  total+=amplitude*mix(low,high,t.z);\n  weight+=amplitude;\n  p=p*2.03+vec3<f32>(7.1,3.7,5.4);\n  amplitude*=0.5;\n}\nlet density=smoothstep(0.50,0.63,total/weight);\ns.opacity=density*0.50;\ns.color=mix(vec3<f32>(0.69,0.79,0.83),vec3<f32>(1.0,0.98,0.92),density);\ns.roughness=1.0;\ns.reflectivity=0.0;\ns.ior=1.0;\nreturn s;"
          },
          {
            "uuid": "200c547a-4cd2-42c0-a232-c15394f67df9",
