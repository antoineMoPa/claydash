            },
            "wgsl": "var s=base;\nlet a=atan2(point.z,point.x);\nlet uv=vec2<f32>(a*7.0,point.y*2.5);\nlet cell=floor(uv);\nlet seed=fract(sin(dot(cell,vec2<f32>(127.1,311.7)))*43758.5453);\nlet furrow=sin(uv.y*26.0+seed*6.28)*0.018;\nvar field=vec3<f32>(0.24,0.44,0.17);\nif(seed>0.76){field=vec3<f32>(0.57,0.60,0.30);}\nelse if(seed>0.48){field=vec3<f32>(0.38,0.55,0.20);}\nelse if(seed>0.23){field=vec3<f32>(0.22,0.39,0.15);}\nlet boundary=min(min(fract(uv.x),1.0-fract(uv.x)),min(fract(uv.y),1.0-fract(uv.y)));\nfield=mix(field*0.68,field,smoothstep(0.0,0.07,boundary));\nlet wooded=sin(a*9.0+sin(point.y*0.61)*2.0)*sin(point.y*1.3-a*3.0)+0.38*sin(a*21.0+point.y*3.0);\nfield=mix(field,vec3<f32>(0.075,0.21,0.095),smoothstep(0.57,0.9,wooded));\nlet bend=-0.42+0.38*sin(point.y*0.42)+0.13*sin(point.y*1.06);\nlet river=abs(atan2(sin(a-bend),cos(a-bend)));\nfield=mix(field,vec3<f32>(0.13,0.42,0.52),1.0-smoothstep(0.055,0.095,river));\ns.color=field+vec3<f32>(furrow);\ns.roughness=0.9;\nreturn s;"
          },
