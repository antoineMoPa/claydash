            "wgsl": "var s=base;\nlet a=atan2(point.z,point.x);\nlet uv=vec2<f32>(a*7.0,point.y*2.5);\nlet wooded=sin(a*9.0+sin(point.y*0.61)*2.0)*sin(point.y*1.3-a*3.0)+0.38*sin(a*21.0+point.y*3.0);\nlet treeGrid=uv*3.3;\nlet treeCell=floor(treeGrid);\nlet treeJitter=vec2<f32>(\n  fract(sin(dot(treeCell,vec2<f32>(91.7,274.3)))*43758.5453),\n  fract(sin(dot(treeCell,vec2<f32>(177.3,61.9)))*43758.5453));\nlet treeLocal=fract(treeGrid)-vec2<f32>(0.38,0.38)-treeJitter*0.24;\nlet canopy=(1.0-smoothstep(0.17,0.29,length(treeLocal)))*smoothstep(0.12,0.56,wooded);\nlet villageCell=floor(uv*0.27);\nlet village=fract(sin(dot(villageCell,vec2<f32>(53.1,119.7)))*43758.5453);\nlet houseGrid=uv*1.7;\nlet houseCell=floor(houseGrid);\nlet houseSeed=fract(sin(dot(houseCell,vec2<f32>(217.7,83.1)))*43758.5453);\nlet houseLocal=abs(fract(houseGrid)-vec2<f32>(0.5,0.5));\nlet roof=(1.0-smoothstep(0.13,0.17,houseLocal.x))*(1.0-smoothstep(0.18,0.22,houseLocal.y));\nlet settlement=step(0.72,village)*step(0.73,houseSeed)*(1.0-smoothstep(0.05,0.4,wooded));\nlet buildings=roof*settlement;\nlet leafColor=mix(vec3<f32>(0.04,0.14,0.055),vec3<f32>(0.19,0.35,0.12),clamp(treeLocal.x+treeLocal.y+0.5,0.0,1.0));\nlet roofColor=select(vec3<f32>(0.23,0.26,0.27),vec3<f32>(0.56,0.28,0.17),houseSeed>0.86);\ns.color=mix(leafColor,roofColor,buildings);\ns.opacity=clamp(max(canopy*0.87,buildings*0.96),0.0,1.0);\ns.roughness=0.96;\ns.reflectivity=0.0;\ns.ior=1.0;\nreturn s;"
